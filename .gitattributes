# Keep Vite production text assets and POSIX shell scripts in LF on Windows checkouts
# so `npm run build` never marks built `web/` text assets dirty due to CRLF conversion.
web/** text eol=lf
web/**/*.avif binary
web/**/*.webp binary
web/**/*.png binary
web/**/*.jpg binary
web/**/*.jpeg binary
web/**/*.gif binary
web/**/*.ico binary
web/**/*.woff binary
web/**/*.woff2 binary
*.sh text eol=lf
